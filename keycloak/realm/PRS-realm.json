{
  "realm": "PRS",
  "enabled": true,
  "displayName": "Cañete Seguro - PRS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Super administrador (todas las municipalidades)"
      },
      {
        "name": "MUNICIPALIDAD_ADMIN",
        "description": "Administrador de municipalidad (RUC titular o DNI)"
      },
      {
        "name": "CIUDADANO",
        "description": "Ciudadano (app)"
      },
      {
        "name": "ENTIDAD_ADMIN",
        "description": "Administrador institucional (RUC)"
      },
      {
        "name": "OPERADOR_ENTIDAD",
        "description": "Operador de entidad"
      },
      {
        "name": "ANALISTA",
        "description": "Analista (métricas, solo lectura; entidad o municipalidad)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "prs-gateway",
      "name": "Cañete Seguro API Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "prs-web",
      "name": "Cañete Seguro Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*",
        "https://lab.vallegrande.edu.pe/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200",
        "https://lab.vallegrande.edu.pe",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true
    },
    {
      "clientId": "prs-auth",
      "name": "vg-ms-auth bridge",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${AUTH_KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@caneteseguro.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Sistema",
      "realmRoles": [
        "SUPER_ADMIN"
      ]
    },
    {
      "username": "ciudadano",
      "enabled": true,
      "email": "ciudadano@caneteseguro.local",
      "emailVerified": true,
      "firstName": "Ciudadano",
      "lastName": "Demo",
      "realmRoles": [
        "CIUDADANO"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "prs-claims",
      "description": "Claims de negocio Cañete Seguro (uid, dni, eid, ...)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "uid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "uid",
            "claim.name": "uid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "dni",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "dni",
            "claim.name": "dni",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "eid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "eid",
            "claim.name": "eid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ruc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ruc",
            "claim.name": "ruc",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "razonSocial",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "razonSocial",
            "claim.name": "razonSocial",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tipoEntidad",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tipoEntidad",
            "claim.name": "tipoEntidad",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "loginTipo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "loginTipo",
            "claim.name": "loginTipo",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "telefono",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "telefono",
            "claim.name": "telefono",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "family_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "mid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "mid",
            "claim.name": "mid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "prs-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "prs-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "titular",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "titular",
            "claim.name": "titular",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "prs-claims",
    "web-origins",
    "acr"
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"min\": 1, \"max\": 255}, \"pattern\": {\"pattern\": \"^[^<>&\\\"$%!#?§;*~/\\\\\\\\{}=+|]+$\", \"error-message\": \"Contiene caracteres no permitidos\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"min\": 1, \"max\": 255}, \"pattern\": {\"pattern\": \"^[^<>&\\\"$%!#?§;*~/\\\\\\\\{}=+|]+$\", \"error-message\": \"Contiene caracteres no permitidos\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"admin\", \"user\"]}}, {\"name\": \"uid\", \"displayName\": \"ID usuario/entidad (Mongo)\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-f0-9]{24}$\", \"error-message\": \"Identificador inválido\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-identidad\"}, {\"name\": \"dni\", \"displayName\": \"DNI (o RUC en cuentas institucionales)\", \"validations\": {\"pattern\": {\"pattern\": \"^(\\\\d{8}|\\\\d{11})$\", \"error-message\": \"DNI/RUC inválido\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-identidad\"}, {\"name\": \"telefono\", \"displayName\": \"Teléfono\", \"validations\": {\"pattern\": {\"pattern\": \"^\\\\+?\\\\d{6,15}$\", \"error-message\": \"Teléfono inválido\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-identidad\"}, {\"name\": \"loginTipo\", \"displayName\": \"Tipo de cuenta\", \"validations\": {\"options\": {\"options\": [\"PERSONAL\", \"INSTITUCIONAL\"]}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-identidad\"}, {\"name\": \"appRoles\", \"displayName\": \"Roles PRS\", \"validations\": {}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": true, \"group\": \"prs-identidad\"}, {\"name\": \"eid\", \"displayName\": \"ID municipalidad/entidad (tenant)\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-f0-9]{24}$\", \"error-message\": \"Identificador inválido\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-tenant\"}, {\"name\": \"ruc\", \"displayName\": \"RUC de la entidad\", \"validations\": {\"pattern\": {\"pattern\": \"^\\\\d{11}$\", \"error-message\": \"RUC inválido\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-tenant\"}, {\"name\": \"razonSocial\", \"displayName\": \"Nombre de la municipalidad/entidad\", \"validations\": {\"length\": {\"max\": 255}, \"pattern\": {\"pattern\": \"^[^<>&\\\"$%!#?§;*~/\\\\\\\\{}=+|]+$\", \"error-message\": \"Contiene caracteres no permitidos\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-tenant\"}, {\"name\": \"tipoEntidad\", \"displayName\": \"Tipo de entidad\", \"validations\": {\"length\": {\"max\": 100}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-tenant\"}, {\"name\": \"mid\", \"displayName\": \"Municipalidad (id)\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-f0-9]{24}$\", \"error-message\": \"Identificador inválido\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-tenant\"}, {\"name\": \"titular\", \"displayName\": \"Cuenta titular\", \"validations\": {\"options\": {\"options\": [\"true\", \"false\"]}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false, \"group\": \"prs-tenant\"}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}, {\"name\": \"prs-identidad\", \"displayHeader\": \"Identidad PRS\", \"displayDescription\": \"Datos de la cuenta en Cañete Seguro\"}, {\"name\": \"prs-tenant\", \"displayHeader\": \"Municipalidad / entidad\", \"displayDescription\": \"Entidad (tenant) a la que pertenece la cuenta\"}]}"
          ]
        }
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ]
}
