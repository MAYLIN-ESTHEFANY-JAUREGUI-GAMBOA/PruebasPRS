{
  "info": {
    "name": "Cañete Seguro — Auth + Entidades (vía Gateway)",
    "_postman_id": "canete-seguro-backend-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas por http://localhost:9000 (gateway). Ajusta las variables de colección con tus datos reales de MongoDB."
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:9000" },
    { "key": "auth_url", "value": "{{gateway}}/api/auth" },
    { "key": "entidades_url", "value": "{{gateway}}/api/entidades" },
    { "key": "token_admin", "value": "" },
    { "key": "token_ciudadano", "value": "" },
    { "key": "token_entidad", "value": "" },
    { "key": "token_operativo", "value": "" },
    { "key": "entidad_ruc", "value": "20987654321" },
    { "key": "entidad_password", "value": "TU_PASSWORD_ENTIDAD" },
    { "key": "admin_dni", "value": "60973400" },
    { "key": "admin_password", "value": "TU_PASSWORD_ADMIN" },
    { "key": "operador_dni", "value": "12345678" },
    { "key": "operador_password", "value": "TU_PASSWORD_OPERADOR" },
    { "key": "entidad_id", "value": "69ffad55932aaa5a7b52fefe" }
  ],
  "item": [
    {
      "name": "0 — Comprobaciones rápidas",
      "item": [
        {
          "name": "Entidades SIN token (debe 401)",
          "request": {
            "method": "GET",
            "url": "{{entidades_url}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('401 sin JWT', () => pm.response.to.have.status(401));"]
            }
          }]
        },
        {
          "name": "Entidades CON token admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{entidades_url}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('200 con JWT', () => pm.response.to.have.status(200));"]
            }
          }]
        }
      ]
    },
    {
      "name": "1 — Auth público (sin token)",
      "item": [
        {
          "name": "POST register ciudadano",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"11223344\",\n  \"password\": \"ciudadano123\",\n  \"nombres\": \"María\",\n  \"apellidos\": \"García\",\n  \"telefono\": \"987654321\",\n  \"email\": \"maria@test.com\",\n  \"fotoPerfilUrl\": \"https://res.cloudinary.com/demo/image/upload/v1/ciudadanos/identidad/selfie.jpg\",\n  \"fotoPerfilPublicId\": \"ciudadanos/identidad/selfie\"\n}"
            }
          }
        },
        {
          "name": "POST registro/estado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/registro/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"11223344\",\n  \"password\": \"ciudadano123\"\n}"
            }
          }
        },
        {
          "name": "GET cloudinary signature-registro (público)",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/api/cloudinary/signature-registro"
          }
        },
        {
          "name": "POST login APP (ciudadano)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{operador_dni}}\",\n  \"password\": \"{{operador_password}}\",\n  \"contexto\": \"APP\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  pm.collectionVariables.set('token_ciudadano', pm.response.json().token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "POST login ADMIN sistema",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{admin_dni}}\",\n  \"password\": \"{{admin_password}}\",\n  \"contexto\": \"APP\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.collectionVariables.set('token_admin', j.token);"
              ]
            }
          }]
        },
        {
          "name": "POST login entidad (RUC)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/login/entidad",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"{{entidad_ruc}}\",\n  \"password\": \"{{entidad_password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('ENTIDAD_ADMIN', () => pm.expect(j.roles).to.include('ENTIDAD_ADMIN'));",
                "pm.collectionVariables.set('token_entidad', j.token);",
                "if (j.entidadId) pm.collectionVariables.set('entidad_id', j.entidadId);"
              ]
            }
          }]
        },
        {
          "name": "POST login panel (operador) — contexto PANEL_ENTIDAD",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{operador_dni}}\",\n  \"password\": \"{{operador_password}}\",\n  \"contexto\": \"PANEL_ENTIDAD\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('200', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('token_operativo', pm.response.json().token);"
              ]
            }
          }]
        },
        {
          "name": "POST login operativo (legacy /login/operativo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{auth_url}}/login/operativo",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{operador_dni}}\",\n  \"password\": \"{{operador_password}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2 — Auth perfil y panel entidad",
      "item": [
        {
          "name": "GET profile (cualquier token usuario)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_operativo}}" }],
            "url": "{{auth_url}}/profile"
          }
        },
        {
          "name": "GET entidad/mi-entidad",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_entidad}}" }],
            "url": "{{auth_url}}/entidad/mi-entidad"
          }
        },
        {
          "name": "GET entidad/personal",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_entidad}}" }],
            "url": "{{auth_url}}/entidad/personal"
          }
        },
        {
          "name": "GET entidad/gestion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_entidad}}" }],
            "url": "{{auth_url}}/entidad/gestion"
          }
        },
        {
          "name": "GET entidad/usuarios (ENTIDAD_ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_entidad}}" }],
            "url": "{{auth_url}}/entidad/usuarios"
          }
        },
        {
          "name": "POST entidad/usuarios — crear operador",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_entidad}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{auth_url}}/entidad/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"55667788\",\n  \"password\": \"operador456\",\n  \"nombres\": \"Luis\",\n  \"apellidos\": \"Torres\",\n  \"telefono\": \"987000111\",\n  \"email\": \"luis@test.com\",\n  \"rolesIds\": [\"660000000000000000000003\"],\n  \"entidadId\": \"{{entidad_id}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3 — Auth admin sistema",
      "item": [
        {
          "name": "GET admin/usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{auth_url}}/admin/usuarios"
          }
        },
        {
          "name": "GET admin/usuarios/estado/ACTIVO",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{auth_url}}/admin/usuarios/estado/ACTIVO"
          }
        },
        {
          "name": "GET admin/usuarios/solicitudes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{auth_url}}/admin/usuarios/solicitudes?estado=PENDIENTE_APROBACION"
          }
        },
        {
          "name": "POST admin/usuarios/{id}/aprobar-registro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{auth_url}}/admin/usuarios/REEMPLAZAR_ID_USUARIO/aprobar-registro"
          }
        },
        {
          "name": "POST admin/usuarios/{id}/rechazar-registro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{auth_url}}/admin/usuarios/REEMPLAZAR_ID_USUARIO/rechazar-registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"La selfie no muestra el rostro con claridad\"\n}"
            }
          }
        },
        {
          "name": "GET admin/usuarios/dni/{dni}",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{auth_url}}/admin/usuarios/dni/{{operador_dni}}"
          }
        },
        {
          "name": "POST admin/usuarios",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{auth_url}}/admin/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"88776655\",\n  \"password\": \"operador789\",\n  \"nombres\": \"Ana\",\n  \"apellidos\": \"Lopez\",\n  \"telefono\": \"999888777\",\n  \"email\": \"ana@test.com\",\n  \"rolesIds\": [\"660000000000000000000003\"],\n  \"entidadId\": \"{{entidad_id}}\"\n}"
            }
          }
        },
        {
          "name": "PUT admin/usuarios/{id}",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{auth_url}}/admin/usuarios/REEMPLAZAR_ID_USUARIO",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"111222333\"\n}"
            }
          }
        },
        {
          "name": "PATCH admin/usuarios/estado/{id}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{auth_url}}/admin/usuarios/estado/REEMPLAZAR_ID_USUARIO",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"INACTIVO\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4 — Entidades MS (vía gateway)",
      "item": [
        {
          "name": "GET todas las entidades",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{entidades_url}}"
          }
        },
        {
          "name": "GET entidad por id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{entidades_url}}/{{entidad_id}}"
          }
        },
        {
          "name": "GET entidad por RUC",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{entidades_url}}/ruc/{{entidad_ruc}}"
          }
        },
        {
          "name": "GET por tipo BOMBEROS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{entidades_url}}/tipo/BOMBEROS"
          }
        },
        {
          "name": "GET exists/ruc/{ruc}",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": "{{entidades_url}}/exists/ruc/{{entidad_ruc}}"
          }
        }
      ]
    }
  ]
}
