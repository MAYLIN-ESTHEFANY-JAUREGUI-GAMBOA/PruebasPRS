{
  "attributes": [
    {
      "name": "username",
      "displayName": "${username}",
      "validations": {
        "length": {
          "min": 3,
          "max": 255
        },
        "username-prohibited-characters": {},
        "up-username-not-idn-homograph": {}
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "required": {
        "roles": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "email",
      "displayName": "${email}",
      "validations": {
        "email": {},
        "length": {
          "max": 255
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false
    },
    {
      "name": "firstName",
      "displayName": "${firstName}",
      "validations": {
        "length": {
          "min": 1,
          "max": 255
        },
        "pattern": {
          "pattern": "^[^<>&\"$%!#?§;*~/\\\\{}=+|]+$",
          "error-message": "Contiene caracteres no permitidos"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "required": {
        "roles": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "lastName",
      "displayName": "${lastName}",
      "validations": {
        "length": {
          "min": 1,
          "max": 255
        },
        "pattern": {
          "pattern": "^[^<>&\"$%!#?§;*~/\\\\{}=+|]+$",
          "error-message": "Contiene caracteres no permitidos"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      },
      "multivalued": false,
      "required": {
        "roles": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "uid",
      "displayName": "ID usuario/entidad (Mongo)",
      "validations": {
        "pattern": {
          "pattern": "^[a-f0-9]{24}$",
          "error-message": "Identificador inválido"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-identidad"
    },
    {
      "name": "dni",
      "displayName": "DNI (o RUC en cuentas institucionales)",
      "validations": {
        "pattern": {
          "pattern": "^(\\d{8}|\\d{11})$",
          "error-message": "DNI/RUC inválido"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-identidad"
    },
    {
      "name": "telefono",
      "displayName": "Teléfono",
      "validations": {
        "pattern": {
          "pattern": "^\\+?\\d{6,15}$",
          "error-message": "Teléfono inválido"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-identidad"
    },
    {
      "name": "loginTipo",
      "displayName": "Tipo de cuenta",
      "validations": {
        "options": {
          "options": [
            "PERSONAL",
            "INSTITUCIONAL"
          ]
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-identidad"
    },
    {
      "name": "appRoles",
      "displayName": "Roles PRS",
      "validations": {},
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": true,
      "group": "prs-identidad"
    },
    {
      "name": "eid",
      "displayName": "ID municipalidad/entidad (tenant)",
      "validations": {
        "pattern": {
          "pattern": "^[a-f0-9]{24}$",
          "error-message": "Identificador inválido"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-tenant"
    },
    {
      "name": "ruc",
      "displayName": "RUC de la entidad",
      "validations": {
        "pattern": {
          "pattern": "^\\d{11}$",
          "error-message": "RUC inválido"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-tenant"
    },
    {
      "name": "razonSocial",
      "displayName": "Nombre de la municipalidad/entidad",
      "validations": {
        "length": {
          "max": 255
        },
        "pattern": {
          "pattern": "^[^<>&\"$%!#?§;*~/\\\\{}=+|]+$",
          "error-message": "Contiene caracteres no permitidos"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-tenant"
    },
    {
      "name": "tipoEntidad",
      "displayName": "Tipo de entidad",
      "validations": {
        "length": {
          "max": 100
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-tenant"
    },
    {
      "name": "mid",
      "displayName": "Municipalidad (id)",
      "validations": {
        "pattern": {
          "pattern": "^[a-f0-9]{24}$",
          "error-message": "Identificador inválido"
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-tenant"
    },
    {
      "name": "titular",
      "displayName": "Cuenta titular",
      "validations": {
        "options": {
          "options": [
            "true",
            "false"
          ]
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin"
        ]
      },
      "multivalued": false,
      "group": "prs-tenant"
    }
  ],
  "groups": [
    {
      "name": "user-metadata",
      "displayHeader": "User metadata",
      "displayDescription": "Attributes, which refer to user metadata"
    },
    {
      "name": "prs-identidad",
      "displayHeader": "Identidad PRS",
      "displayDescription": "Datos de la cuenta en Cañete Seguro"
    },
    {
      "name": "prs-tenant",
      "displayHeader": "Municipalidad / entidad",
      "displayDescription": "Entidad (tenant) a la que pertenece la cuenta"
    }
  ]
}
