{
  "project": "Cañete Seguro (PRS)",
  "owasp": "API9:2023 Improper Inventory Management",
  "updated": "2026-09-03",
  "publicBaseUrls": {
    "local": "http://localhost:9000",
    "production": "https://lab.vallegrande.edu.pe/canete-seguro"
  },
  "policy": "Solo las rutas listadas en gatewayRoutes son API pública. El resto es interno o sombra.",
  "gatewayRoutes": [
    { "path": "/api/auth/login", "service": "vg-ms-auth", "access": "public" },
    { "path": "/api/auth/register", "service": "vg-ms-auth", "access": "public" },
    { "path": "/api/auth/registration/status", "service": "vg-ms-auth", "access": "public" },
    { "path": "/api/auth/login/entity", "service": "vg-ms-auth", "access": "public" },
    { "path": "/api/auth/login/operator", "service": "vg-ms-auth", "access": "public" },
    { "path": "/api/auth/profile", "service": "vg-ms-usuarios", "access": "authenticated" },
    { "path": "/api/auth/penalty", "service": "vg-ms-usuarios", "access": "authenticated" },
    { "path": "/api/auth/entity/**", "service": "vg-ms-usuarios", "access": "entity_roles" },
    { "path": "/api/auth/admin/**", "service": "vg-ms-usuarios, vg-ms-castigos", "access": "ADMIN" },
    { "path": "/api/entities/**", "service": "vg-ms-entidades", "access": "authenticated" },
    { "path": "/api/catalogs/**", "service": "vg-ms-catalogo", "access": "authenticated" },
    { "path": "/api/recursos/**", "service": "vg-ms-recursos", "access": "authenticated" },
    { "path": "/api/resources/**", "service": "vg-ms-recursos", "access": "authenticated" },
    { "path": "/api/subassignments/**", "service": "vg-ms-subasignacion", "access": "authenticated" },
    { "path": "/api/incidents/**", "service": "vg-ms-incidentes", "access": "authenticated" },
    { "path": "/api/incidents/enriched/**", "service": "vg-ms-incidentes", "access": "authenticated" },
    { "path": "/api/alerts/**", "service": "vg-ms-alertas", "access": "authenticated" },
    { "path": "/api/cloudinary/signature-registration", "service": "vg-ms-auth", "access": "public" },
    { "path": "/api/cloudinary/signature", "service": "vg-ms-media", "access": "authenticated" },
    { "path": "/api/incidents/*/chat/**", "service": "vg-ms-chat", "access": "authenticated" },
    { "path": "/api/admin/inventory", "service": "vg-ms-api-gateway", "access": "ADMIN" }
  ],
  "internalOnly": [
    {
      "path": "/api/v1/users/**",
      "service": "vg-ms-usuarios",
      "port": 9010,
      "risk": "shadow_api",
      "note": "No está en gateway; usada por vg-ms-castigos"
    },
    {
      "path": "/internal/**",
      "services": ["vg-ms-entidades", "vg-ms-recursos", "vg-ms-catalogo", "vg-ms-subasignacion"],
      "risk": "internal_trust_network",
      "note": "Comunicación MS ↔ MS"
    }
  ],
  "documentation": {
    "markdown": "docs/API9-INVENTARIO-PRS.md"
  }
}
