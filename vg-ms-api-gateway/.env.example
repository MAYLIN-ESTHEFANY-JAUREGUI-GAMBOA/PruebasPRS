# Credenciales y configuración del stack Cañete Seguro (docker-compose.yml de esta carpeta).
#   cp .env.example .env   → completar valores reales. NUNCA subir .env a Git.
# Docker Compose lee .env automáticamente: docker compose up -d

# ════════════════════════════════════════════════════════════════════
# Keycloak (compartido) — único emisor y validador de tokens
# ════════════════════════════════════════════════════════════════════
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-keycloak-admin-password
KEYCLOAK_HOST_PORT=8090
KEYCLOAK_REALM=PRS
# Issuer que va dentro del token (URL pública de Keycloak)
# URL pública de Keycloak (KC_HOSTNAME). Local: http://localhost:8090 · Dokploy: https://auth.tu-dominio
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/PRS
# Audiencia exigida en el JWT (gateway, usuarios, castigos, municipalidades). Vacío = sin validar.
# Antes de poner prs-api, agrega el mapper Audience "prs-api" al client scope prs-claims en Keycloak.
KEYCLOAK_AUDIENCE=
# URL de Keycloak dentro de la red Docker (JWK Set y Admin API)
KEYCLOAK_INTERNAL_URL=http://keycloak:8090

# ════════════════════════════════════════════════════════════════════
# vg-ms-api-gateway
# ════════════════════════════════════════════════════════════════════
# Token compartido para /internal/** entre micros (generar: openssl rand -hex 32)
INTERNAL_API_TOKEN=
GATEWAY_HOST_PORT=9000
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:8081,http://localhost:9000,https://lab.vallegrande.edu.pe

# ════════════════════════════════════════════════════════════════════
# vg-ms-auth
# ════════════════════════════════════════════════════════════════════
# Secret del client confidencial prs-auth (Keycloak → Clients → prs-auth → Credentials)
AUTH_KEYCLOAK_CLIENT_SECRET=replace-with-prs-auth-client-secret
# Cloudinary propio de auth (selfie de registro)
AUTH_CLOUDINARY_CLOUD_NAME=your-auth-cloud-name
AUTH_CLOUDINARY_API_KEY=your-auth-api-key
AUTH_CLOUDINARY_API_SECRET=your-auth-api-secret
AUTH_CLOUDINARY_FOLDER_REGISTRO=ciudadanos/identidad

# ════════════════════════════════════════════════════════════════════
# vg-ms-usuarios (auth también usa esta URI: db_usuarios + db_auth)
# ════════════════════════════════════════════════════════════════════
SPRING_MONGODB_URI_USUARIOS=mongodb+srv://<user>:<password>@<cluster>/db_usuarios
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

# ════════════════════════════════════════════════════════════════════
# vg-ms-castigos
# ════════════════════════════════════════════════════════════════════
SPRING_MONGODB_URI_CASTIGOS=mongodb+srv://<user>:<password>@<cluster>/db_castigos

# ════════════════════════════════════════════════════════════════════
# vg-ms-municipalidades
# ════════════════════════════════════════════════════════════════════
SPRING_MONGODB_URI_MUNICIPALIDADES=mongodb+srv://<user>:<password>@<cluster>/db_municipalidades


# ════════════════════════════════════════════════════════════════════
# Otros equipos (no los usan gateway/auth/usuarios/castigos/municipalidades)
# ════════════════════════════════════════════════════════════════════
# Secreto HMAC que aún leen algunos micros de otros equipos
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-64-characters-0000000000
SPRING_MONGODB_URI_ENTIDADES=mongodb+srv://<user>:<password>@<cluster>/db_entidades
SPRING_MONGODB_URI_ALERTAS=mongodb+srv://<user>:<password>@<cluster>/db_alertas
SPRING_MONGODB_URI_INCIDENTES=mongodb+srv://<user>:<password>@<cluster>/db_incidentes
SPRING_MONGODB_URI_RECURSOS=mongodb+srv://<user>:<password>@<cluster>/db_recursos
SPRING_MONGODB_URI_SUBASIGNACION=mongodb+srv://<user>:<password>@<cluster>/db_subasignacion
SPRING_MONGODB_URI_CATALOGOS=mongodb+srv://<user>:<password>@<cluster>/db_catalogos
SPRING_MONGODB_URI_CHAT=mongodb+srv://<user>:<password>@<cluster>/db_chat
SPRING_MONGODB_URI_FLOTA=mongodb+srv://<user>:<password>@<cluster>/db_flota
SONAR_HOST_PORT=9090
