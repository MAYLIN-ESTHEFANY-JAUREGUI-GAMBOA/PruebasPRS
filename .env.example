# Variables de build del panel web (se pasan como --build-arg al Dockerfile). Sin secretos.

# API y ruta pública
NG_APP_API_URL=https://lab.vallegrande.edu.pe/canete-seguro
NG_APP_BASE_HREF=/web-seguro-app/

# Reportes (estándar AS241S6 §14)
# Logo de la plataforma (SUPER_ADMIN o municipalidad sin logo). Vacío = escudo de Cañete Seguro embebido.
# PNG/SVG < 200 KB; debe permitir CORS (p. ej. Cloudinary).
REPORT_LOGO_URL=
# Color institucional de la cabecera (PDF, Excel e impresión)
REPORT_HEADER_COLOR=#1E5BA1
# Pie del PDF: {X} = página actual, {Y} = total
REPORT_PDF_FOOTER=Página {X} de {Y}
